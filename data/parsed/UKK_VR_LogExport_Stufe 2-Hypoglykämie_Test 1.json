            "text": "hmmm..."
        },
        {
            "wall_clock": "13:04:49",
            "sim_time": "2:34",
            "sim_time_seconds": 154,
            "text": "Mhm."
        },
        {
            "wall_clock": "13:04:57",
            "sim_time": "2:42",
            "sim_time_seconds": 162,
            "text": "Sascha, PVK, linke obere Extremität."
        },
        {
            "wall_clock": "13:05:19",
            "sim_time": "3:04",
            "sim_time_seconds": 184,
            "text": "Hmmmm."
        },
        {
            "wall_clock": "13:05:37",
            "sim_time": "3:22",
            "sim_time_seconds": 202,
            "text": "Robin, 3-Kanal-EKG, SpO2 und Blutdruckmanschette anlegen."
        },
        {
            "wall_clock": "13:05:53",
            "sim_time": "3:39",
            "sim_time_seconds": 219,
            "text": "Mmh."
        },
        {
            "wall_clock": "13:06:29",
            "sim_time": "4:14",
            "sim_time_seconds": 254,
            "text": "Heeeeeeeeeeeeee."
        },
        {
            "wall_clock": "13:07:08",
            "sim_time": "4:53",
            "sim_time_seconds": 293,
            "text": "Fremskrequenz auch gut. Okay. A kein Problem. B kein Problem. C hat Riccardo Normo tun. D..."
        },
        {
            "wall_clock": "13:07:14",
            "sim_time": "4:59",
            "sim_time_seconds": 299,
            "text": "Neurologische Untersuchung."
        },
        {
            "wall_clock": "13:07:40",
            "sim_time": "5:26",
            "sim_time_seconds": 326,
            "text": "CS. Sascha, hat der Patient bereits einen Zugang?"
        },
        {
            "wall_clock": "13:07:58",
            "sim_time": "5:43",
            "sim_time_seconds": 343,
            "text": "Ich bin Ihr behandelnder Arzt."
        },
        {
            "wall_clock": "13:08:01",
            "sim_time": "5:46",
            "sim_time_seconds": 346,
            "text": "Sascha, was machst du da?"
        },
        {
            "wall_clock": "13:08:05",
            "sim_time": "5:51",
            "sim_time_seconds": 351,
            "text": "Sascha, was machst du gerade?"
        },
        {
            "wall_clock": "13:09:28",
            "sim_time": "7:13",
            "sim_time_seconds": 433,
            "text": "Ah, du bist zurück. Schön, Robin. Robin, gibt es Auffälligkeiten in der BGA?"
        },
        {
            "wall_clock": "13:10:01",
            "sim_time": "7:46",
            "sim_time_seconds": 466,
            "text": "Okay, Infusion. Robin, G5 1 Liter Infusion über PVK links."
        },
        {
            "wall_clock": "13:13:31",
            "sim_time": "11:17",
            "sim_time_seconds": 677,
            "text": "BZ60. Okay. G5 läuft. So."
        },
        {
            "wall_clock": "13:15:36",
            "sim_time": "13:21",
            "sim_time_seconds": 801,
            "text": "Sascha BGA durchführen."
        },
        {
            "wall_clock": "13:15:52",
            "sim_time": "13:37",
            "sim_time_seconds": 817,
            "text": "Immer noch 60."
        },
        {
            "wall_clock": "13:16:03",
            "sim_time": "13:48",
            "sim_time_seconds": 828,
            "text": "Robin, Blutab nehmen, rechte obere Extremität, BGA."
        },
        {
            "wall_clock": "13:16:10",
            "sim_time": "13:55",
            "sim_time_seconds": 835,
            "text": "Robin, nimm an der rechten oberen Extremität einmal Blut ab und mach eine BGA."
