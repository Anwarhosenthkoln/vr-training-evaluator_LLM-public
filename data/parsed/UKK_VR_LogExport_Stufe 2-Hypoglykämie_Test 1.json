    "patient_talk": [
        {
            "wall_clock": "13:03:10",
            "sim_time": "0:55",
            "sim_time_seconds": 55,
            "text": "Mir ist so kalt und mein Herz rast."
        },
        {
            "wall_clock": "13:04:42",
            "sim_time": "2:27",
            "sim_time_seconds": 147,
            "text": "Mein Herz schlägt auf einmal so schnell."
        },
        {
            "wall_clock": "13:06:15",
            "sim_time": "4:00",
            "sim_time_seconds": 240,
            "text": "Ich fühle mich so fürchterlich schwach."
        },
        {
            "wall_clock": "13:07:50",
            "sim_time": "5:35",
            "sim_time_seconds": 335,
            "text": "Wer sind Sie?"
        },
        {
            "wall_clock": "13:10:13",
            "sim_time": "7:58",
            "sim_time_seconds": 478,
            "text": "Haben Sie schon wieder Dienst?"
        },
        {
            "wall_clock": "13:12:21",
            "sim_time": "10:06",
            "sim_time_seconds": 606,
            "text": "Was machen Sie da?"
        },
        {
            "wall_clock": "13:14:33",
            "sim_time": "12:18",
            "sim_time_seconds": 738,
            "text": "Ich habe so einen Hunger."
        },
        {
            "wall_clock": "13:16:51",
            "sim_time": "14:37",
            "sim_time_seconds": 877,
            "text": "Wo bin ich?"
        }
    ],
    "voice_control": [
        {
            "wall_clock": "02:04:27",
            "sim_time": "17.757.133:02:13",
            "sim_time_seconds": 0,
            "text": "Ok, Hypoglycemia Stufe 1. Hochgehen ABCDE. Ok, Start."
        },
        {
            "wall_clock": "13:03:44",
            "sim_time": "1:29",
